# انسخ الملف ده باسم keystore.properties (من غير .example) في جذر المشروع
# وعبّي البيانات الحقيقية بتاعتك. الملف ده *لازم* يتضاف لـ .gitignore ومتترفعوش
# على أي مكان عام أبدًا — أي حد يوصله يقدر يوقّع تحديثات باسم تطبيقك.
#
# لو عايز تعمل الـ keystore لأول مرة، استخدم الأمر ده (خارج هذا الملف):
#   keytool -genkey -v -keystore release.keystore -alias expense_tracker \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=expense_tracker
keyPassword=CHANGE_ME
